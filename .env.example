# Community: copy to .env; never commit populated secrets.
PHISHCASE_PORT=8088
COOKIE_SECURE=false
# offline (default), restricted (lookup only), connected (explicit submission flags)
CONNECTIVITY_MODE=offline
# Explicit DNS verification only; offline always refuses, even when true.
DKIM_LOOKUP_ENABLED=false
JOB_TIMEOUT_SECONDS=180
JOB_MAX_ATTEMPTS=3
PARSER_MEMORY_MB=768
# Optional BYOK credentials are passed through the provided Compose environment.
# VIRUSTOTAL_API_KEY=
# URLSCAN_API_KEY=
# VIRUSTOTAL_ALLOW_FILE_SUBMISSION=false
# VIRUSTOTAL_ALLOW_URL_SUBMISSION=false
# URLSCAN_ALLOW_URL_SUBMISSION=false
# MFA_ENCRYPTION_KEY=  # Stable Fernet key if supplied externally. Back it up.
